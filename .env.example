# Copy to .env and fill in what you have. .env is gitignored; never commit a real key.
# Everything is optional: with nothing set, LeadFlow runs on built-in rules and simulates the integrations.

GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b      (any model from https://console.groq.com/docs/models)

# Signs the paused workflow state sent to the browser. Generate: python -c "import secrets; print(secrets.token_hex(32))"
STATE_SIGNING_KEY=

# Google Sheets: deploy scripts/sheets_webhook.gs as an Apps Script web app and paste its URL
GOOGLE_SHEETS_WEBHOOK_URL=

# Telegram: create a bot with @BotFather, then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Resend (https://resend.com): FROM_EMAIL must be on a domain you verified there
RESEND_API_KEY=
FROM_EMAIL=

# ---- Real intake (all optional) ----
# Shared secrets you make up yourself (e.g. python -c "import secrets; print(secrets.token_urlsafe(24))")
INTAKE_KEY=          # sent by the Gmail script / website form as the X-Intake-Key header
ADMIN_TOKEN=         # typed into Settings → Real intake to see the live inbox and approve stored leads

# Supabase (run scripts/supabase_schema.sql first). Service key = Project Settings → API → service_role. Server only!
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# WhatsApp Cloud API (Meta for Developers → WhatsApp → API setup). Webhook URL: https://<your-app>/api/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=     # any string; paste the same one in Meta's webhook settings
WHATSAPP_APP_SECRET=       # App settings → Basic → App secret (used to verify Meta's signature)
WHATSAPP_BUSINESS_ID=ca    # which business incoming WhatsApp messages belong to

# LangSmith tracing (https://smith.langchain.com). Traces include customer messages: use demo data, or also set
# LANGSMITH_HIDE_INPUTS=true and LANGSMITH_HIDE_OUTPUTS=true when real leads flow through.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=leadflow

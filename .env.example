# Copy to .env and fill in what you have. .env is gitignored; never commit a real key.
# Everything is optional: with nothing set, LeadFlow runs on built-in rules and simulates the integrations.

GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b      (any model from https://console.groq.com/docs/models)

# Signs the paused workflow state sent to the browser. Generate: python -c "import secrets; print(secrets.token_hex(32))"
STATE_SIGNING_KEY=

# Google Sheets: deploy scripts/sheets_webhook.gs as an Apps Script web app and paste its URL
GOOGLE_SHEETS_WEBHOOK_URL=

# Telegram: create a bot with @BotFather, then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Resend (https://resend.com): FROM_EMAIL must be on a domain you verified there
RESEND_API_KEY=
FROM_EMAIL=
